<Window x:Class="ServoPress.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ServoPress.Views"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        
        xmlns:viewmodels="clr-namespace:ServoPress.ViewModels"
        xmlns:behaviors="clr-namespace:ServoPress.Behaviors"
        
        mc:Ignorable="d"
        Height="1000" Width="1500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" BorderThickness="1" 
        BorderBrush="{StaticResource BorderBrush}"
        Background="White"
        
        behaviors:WindowBehavior.CloseWindowTrigger="{Binding IsCloseRequested}"
        WindowState="{Binding WindowState, Mode=TwoWay}">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- (资源... 保持不变) -->
        <Style x:Key="TopBarTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="TopBarLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#FFD0E0FF"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="NavIconStyle" TargetType="svgc:SvgViewbox">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 修正最大化边距 -->
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                        <Setter Property="Margin" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>


        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. 顶部自定义标题栏 (保持不变) -->
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" BorderBrush="#FF005A9E" BorderThickness="0,0,0,1" MinHeight="40">
            <Grid behaviors:WindowBehavior.EnableDragMove="True">

                <TextBlock Text="伺服压机智能控制系统" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Style="{StaticResource TopBarTextStyle}"/>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">

                    <Button Style="{StaticResource WindowControlButtonStyle}" 
                            ToolTip="最小化"
                            Command="{Binding MinimizeWindowCommand}">
                        <svgc:SvgViewbox Source="/Resources/Icons/Min.svg" Width="16" Height="16"/>
                    </Button>

                    <Button Style="{StaticResource WindowControlButtonStyle}" 
                            ToolTip="最大化"
                            Command="{Binding ToggleMaximizeWindowCommand}">
                        <svgc:SvgViewbox Source="/Resources/Icons/Max.svg" Width="16" Height="16"/>
                    </Button>

                    <Button Style="{StaticResource WindowCloseButtonStyle}" 
                            ToolTip="关闭"
                            Command="{Binding CloseWindowCommand}">
                        <svgc:SvgViewbox Source="/Resources/Icons/Close.svg" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 2.1. 左侧导航栏 (已修改) -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- (设备状态模块 ... 保持不变) -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Margin="10" CornerRadius="4" Padding="15">
                        <StackPanel>
                            <TextBlock Text="设备状态:" FontSize="14" Style="{StaticResource TopBarLabelStyle}"/>
                            <TextBlock Text="{Binding SystemStatus}"  Foreground="{Binding SystemStatusColor}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="产品型号:" FontSize="14" Style="{StaticResource TopBarLabelStyle}"/>
                            <TextBlock Text="Y29" FontSize="16" FontWeight="Bold" Style="{StaticResource TopBarTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- 
                      导航列表 (已修改)
                      我们在这里添加一个局部的 TextBlock 样式
                    -->
                    <ListBox x:Name="NavListBox"
                             DockPanel.Dock="Top"
                             BorderThickness="0"
                             Background="Transparent"
                             Width="220"
                             ItemContainerStyle="{StaticResource NavButtonStyle}"
                             SelectedIndex="0">

                        <!-- 
                          新增: 局部资源
                          此样式会覆盖 App.xaml 中的全局 TextBlock 样式, 
                          但 *仅* 限于此 ListBox 内部。
                        -->
                        <ListBox.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <!-- 
                                  强制 TextBlock 的字体颜色 
                                  绑定到其父 ListBoxItem 的字体颜色
                                -->
                                <Setter Property="Foreground" 
                                        Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </Style>
                        </ListBox.Resources>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox Style="{StaticResource NavIconStyle}"/>
                                <TextBlock Text="🏭 实时生产" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox Style="{StaticResource NavIconStyle}"/>
                                <TextBlock Text="⚙️ 参数设置" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                  <svgc:SvgViewbox Style="{StaticResource NavIconStyle}"/>
                                <TextBlock Text="📜序列编辑" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox Style="{StaticResource NavIconStyle}"/>
                                <TextBlock Text="📈 历史数据" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox Style="{StaticResource NavIconStyle}"/>
                                <TextBlock Text="🛠️ 系统管理" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 2.2. 右侧内容区 (保持不变) -->
            <TabControl Grid.Column="1"
                        x:Name="MainContentTabs"
                        Background="{StaticResource WindowBackgroundBrush}"
                        BorderThickness="0"
                        TabStripPlacement="Left"
                        SelectedIndex="{Binding ElementName=NavListBox, Path=SelectedIndex}">

                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabItem Header="主页">
                    <views:ProductionView DataContext="{Binding ProductionVM}" />
                </TabItem>

                <TabItem Header="参数设置">
                    <views:SettingsView />
                </TabItem>


                <TabItem Header="序列编辑">
                    <views:SequenceEditorView />
                </TabItem>


                <TabItem Header="历史数据">
                    <views:HistoryView />
                </TabItem>

                <TabItem Header="系统管理">
                    <views:SystemAdminView />
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>